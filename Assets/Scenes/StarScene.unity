--- !u!114 &2009779874
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2009779872}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9e1721c1ab7b46e43b5ec811684205e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textboxes:
  - textBox: {fileID: 1222954973}
    fullText: Wherever you were once meant to be, it no longer matters.
    triggerPoint: {fileID: 1380119314}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 852798473}
    fullText: Whatever you wished you were, no longer matters.
    triggerPoint: {fileID: 1620577323}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 1079344436}
    fullText: 'You are now truly home,

      back in the place you

      were never
      meant

      to go.'
    triggerPoint: {fileID: 2071360646}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 1339075270}
    fullText: 'You can feel it, this was what it was

      all about...'
    triggerPoint: {fileID: 1086577981}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 1889078386}
    fullText: or
    triggerPoint: {fileID: 517297657}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 1323799175}
    fullText: was
    triggerPoint: {fileID: 1401668370}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 1336411210}
    fullText: it?
    triggerPoint: {fileID: 727303841}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 859936507}
    fullText: Who are you?
    triggerPoint: {fileID: 1863723998}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 2050970879}
    fullText: I DONT KNOW
    triggerPoint: {fileID: 1863723998}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 1496475323}
    fullText: Sasha.. the stage is set, I'm afraid
    triggerPoint: {fileID: 883894152}
    triggerDistance: 7.6
    hasStarted: 0
  - textBox: {fileID: 1327301132}
    fullText: And play the part you will.
    triggerPoint: {fileID: 360557297}
    triggerDistance: 7.6
    hasStarted: 0
  player: {fileID: 1945939498}
  letterDelay: 0.05
