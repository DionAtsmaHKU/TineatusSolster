title: Start
---
<< declare $TestStat = 0 >>
<< declare $ArtMajor = false >>
<< declare $TechMajor = false >>
<< declare $PsychMajor = false >>


// Fabian Related Variables
<< declare $FabianMood = 0 >> // Higher number means happier, lower means sadder
<< declare $FabianFamiliarity = 0 >> // Increases as you talk to him and he gets to know you. Does not go below 0. Resets only on loop

Dion: Hi this is a placeholder for picking your major at the start of the game :D
-> Art!
    << set $ArtMajor = true >>
-> Tech!
    << set $TechMajor = true >>
-> Psych!
    << set $PsychMajor = true >>

<<if $ArtMajor == true>>
    <<jump ArtDialogue>>
<<endif>>

<<if $TechMajor == true>>
    <<jump TechDialogue>>
<<endif>>

<<if $PsychMajor == true>>
    <<jump PsychDialogue>>
<<endif>>
===

title: ArtDialogue
---
<< SetSashaSprite 0 >>
Sasha: Art!
art time
<< Learn InfoA >>
===

title: TechDialogue
---
<< SetSashaSprite 1 >>
Sasha: Technology!
Tech time
<< Learn InfoB >>
===

title: PsychDialogue
---
<< SetSashaSprite 2 >>
Sasha: Psychology!
psych time
<< Learn InfoC >>
===

