//Dmitriy Variables
<<set $NotSeenDmiHi = true>>
<<set $DmiAnnoyed = 0>>
<<set $BoatDmiTogether = false>>
<<set $Boatmad = true>>
<<set $SeenIslandDmi = false>>

// Fabian Related Variables
<< set $FabianMood = 0 >> // Higher number means happier, lower means sadder
<< set $FabianFamiliarity = 0 >> // Increases as you talk to him and he gets to know you. Does not go below 0. Resets only on loop

<< set $IntroFabianTree1WhoAreYou = false >>
<< set $IntroFabianTree1WhereDmitriy = false >>
<< set $IntroFabianTree2Alfonz = false >>
<< set $IntroFabianTree2Dmitriy = false >>
<< set $IntroFabianTree2VoidLake = false >>
<< set $IntroFabianTree2Elegy = false >>

(Choose which Major Sasha studied in college.)
-> Art
    << set $ArtMajor = true >>
	<< SetSashaSprite 0 >>
    << SetModel Art >>
-> Engineering
    << set $TechMajor = true >>
	<< SetSashaSprite 1 >>
    << SetModel Tech >>
-> Psychology
    << set $PsychMajor = true >>
	<< SetSashaSprite 2 >>
    << SetModel Psych >>
	
NARRATOR: And just like that, the play has started all over again.

===